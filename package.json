  "author": "Nahid Akbar <mail@nahidakbar.net> (http://nahidakbar.net/)",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nahidakbar/node-pretty-print-hscode.git"
  },
  "bugs": {
    "url": "https://github.com/nahidakbar/node-pretty-print-hscode/issues"
  },
  "homepage": "https://github.com/nahidakbar/node-pretty-print-hscode#readme",
  "funding": {
    "url": "https://github.com/sponsors/nahidakbar"
  }

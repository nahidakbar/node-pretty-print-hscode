{
  "name": "pretty-print-hscode",
  "version": "0.1.0",
  "description": "Pretty print Harmonized System (HS) codes",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "require": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "pretty",
    "print",
    "harmonized",
    "system",
    "hs",
    "code"
